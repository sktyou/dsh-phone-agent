# Build output
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/local.properties
android/captures/
*.iml
.gradle/
.kotlin/

# The APK is published as a Release asset, not committed: at 51 MB it would be
# re-stored in full on every rebuild and bloat the repository for no benefit.
DSHPhoneAgent-debug.apk
*.apk

# Debugging frames. docs/ accumulated ~100 full-screen captures during development
# (before/after pairs, comparison shots, scroll tests); they are kept locally but
# are not part of the project. Curated images live in screenshots/.
docs/*.png
docs/*.jpg
docs/gkd-sample.json5
docs/menu-lines.txt
docs/touch.log
docs/menu-*.csv

# Generated into assets at build time: tools/webui/index.html is copied by the
# build script, SKILL.md by syncSkillDoc, and the MCP server + test script by
# syncMcpFiles. Committing the copies would mean two sources of truth that can
# disagree — and the phone serves these to clients, so a stale copy is a real bug.
android/app/src/main/assets/webui/index.html
android/app/src/main/assets/webui/SKILL.md
android/app/src/main/assets/mcp/

node_modules/
